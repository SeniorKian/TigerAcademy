POSTGRES_DB=tigerapp
POSTGRES_USER=tigerapp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TIGERAPP_JWT_SECRET=replace-with-at-least-32-random-characters

# Direct .NET execution reads these values. Docker Compose overrides the database host with "postgres".
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Timeout=5
JwtSettings__Secret=${TIGERAPP_JWT_SECRET}
